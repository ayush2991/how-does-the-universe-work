href":null,"layout":null,"metadata":null,"text":"Prerequisite: An Understanding of Expected Value of Discrete Random Variables.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":34,"end":48,"href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20240301173417\u002Fhttps:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FExpected_value#Random_variables_with_countably_many_outcomes","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*K8v5y5UvNwvS-vSy7J0zww.jpeg":{"__typename":"ImageMetadata","id":"1*K8v5y5UvNwvS-vSy7J0zww.jpeg","originalHeight":3456,"originalWidth":5184,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:89bcb7ca50cf_3":{"__typename":"Paragraph","id":"89bcb7ca50cf_3","name":"9921","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*K8v5y5UvNwvS-vSy7J0zww.jpeg"},"text":"Photo by Siora Photography on Unsplash","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":9,"end":26,"href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20240301173417\u002Fhttps:\u002F\u002Funsplash.com\u002F@siora18?utm_content=creditCopyText&utm_medium=referral&utm_source=unsplash","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"A","start":30,"end":38,"href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20240301173417\u002Fhttps:\u002F\u002Funsplash.com\u002Fphotos\u002Ftwo-round-gold-colored-coins-kY6HbkiauSc?utm_content=creditCopyText&utm_medium=referral&utm_source=unsplash","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_4":{"__typename":"Paragraph","id":"89bcb7ca50cf_4","name":"234d","type":"P","href":null,"layout":null,"metadata":null,"text":"Imagine a coin-tossing scenario with the following outcomes and corresponding probabilities.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_5":{"__typename":"Paragraph","id":"89bcb7ca50cf_5","name":"1dd4","type":"PRE","href":null,"layout":null,"metadata":null,"text":"|  Outcome  | Probability|\n|-----------|------------|\n| Heads (H) |    1       |\n| Tails (T) |    0       |","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":63,"end":65,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":90,"end":91,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":72,"end":80,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_6":{"__typename":"Paragraph","id":"89bcb7ca50cf_6","name":"a48e","type":"P","href":null,"layout":null,"metadata":null,"text":"These values indicate that the coin always shows up heads (H), and if we know that the outcome will always be H, we experience zero “surprise” when we see the actual outcome. It is always H.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":59,"end":60,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":110,"end":111,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":188,"end":189,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_7":{"__typename":"Paragraph","id":"89bcb7ca50cf_7","name":"7193","type":"P","href":null,"layout":null,"metadata":null,"text":"More generally, say p is the probability of outcome H. If we use X to denote a random variable which records the outcome of a coin toss, then X takes values in {H, T}. Then Pr(X=H) = p and Pr(X=T)=1-p.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":52,"end":53,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":161,"end":162,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":164,"end":165,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":178,"end":179,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":194,"end":195,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":20,"end":21,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":183,"end":185,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":199,"end":200,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_8":{"__typename":"Paragraph","id":"89bcb7ca50cf_8","name":"a0d8","type":"PRE","href":null,"layout":null,"metadata":null,"text":"|     X     |    Pr(X)   |\n|-----------|------------|\n|     H     |    p       |\n|     T     |    1 - p   |","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":60,"end":61,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":87,"end":88,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":71,"end":80,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_9":{"__typename":"Paragraph","id":"89bcb7ca50cf_9","name":"52ec","type":"P","href":null,"layout":null,"metadata":null,"text":"How do we now generalize the “surprise”?","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_10":{"__typename":"Paragraph","id":"89bcb7ca50cf_10","name":"f5fa","type":"P","href":null,"layout":null,"metadata":null,"text":"First thing to note, the surprise is now potentially non-zero as the outcome is not pre-determined. There could be any number of ways to quantify surprise, but we intuit some properties it must exhibit. For instance, when an outcome is unlikely, the surprise upon its occurring should be high, and when the outcome is quite likely, the surprise must be low. In the extreme case where p=1.0 and the outcome H is certain, the surprise associated with it must be zero .","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":406,"end":407,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":384,"end":385,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_11":{"__typename":"Paragraph","id":"89bcb7ca50cf_11","name":"8e0e","type":"P","href":null,"layout":null,"metadata":null,"text":"For reasons that are outside the scope of this article, we will use log(1\u002Fp) to quantify the surprise associated with an outcome of probability p. This results in a zero surprise for guaranteed outcomes with p=1.0 and outcomes with small values of p will result in a large surprise, just like we want.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":68,"end":77,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*m3HQi3PyyoTD0XTMbmA3wg.png":{"__typename":"ImageMetadata","id":"1*m3HQi3PyyoTD0XTMbmA3wg.png","originalHeight":746,"originalWidth":1204,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:89bcb7ca50cf_12":{"__typename":"Paragraph","id":"89bcb7ca50cf_12","name":"9857","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*m3HQi3PyyoTD0XTMbmA3wg.png"},"text":"Surprise vs. probability | Image by author","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_13":{"__typename":"Paragraph","id":"89bcb7ca50cf_13","name":"23f6","type":"P","href":null,"layout":null,"metadata":null,"text":"Given this formulation, over the course of many coin tosses, we experience a surprise S(H) = log(1\u002Fp) whenever the coin shows up heads, and a surprise S(T) = log(1\u002F(1-p)) whenever it shows up tails.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":88,"end":89,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":153,"end":154,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":99,"end":100,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":167,"end":168,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:89bcb7ca50cf_14":{"__typename":"Paragraph","id":"89bcb7ca50cf_14","name":"93f9","type":"PRE","href":null,"layout":null,"metadata":null,"text":"|  X   |  Pr(X) |     S(X)      |\n|------|--------|---------------|\n|  H   |  p     |  log(1\u002Fp)     |\n|  T   |  1 - p…","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":71,"end":72,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":105,"end":106,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{